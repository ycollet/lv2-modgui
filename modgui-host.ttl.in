@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix patch:  <http://lv2plug.in/ns/ext/patch#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix ui:     <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix work:   <http://lv2plug.in/ns/ext/worker#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix opts:   <http://lv2plug.in/ns/ext/options#> .

# ── Parameters ────────────────────────────────────────────────────────────────
<urn:modgui-host:hostedPluginURI>
    a lv2:Parameter ;
    rdfs:label "Hosted Plugin URI" ;
    rdfs:range atom:String .

<urn:modgui-host:paramSymbol>
    a lv2:Parameter ;
    rdfs:label "Parameter Symbol" ;
    rdfs:range atom:String .

<urn:modgui-host:paramValue>
    a lv2:Parameter ;
    rdfs:label "Parameter Value" ;
    rdfs:range atom:Float .

# ── Plugin ────────────────────────────────────────────────────────────────────
<urn:modgui-host:plugin>
    a lv2:Plugin ;
    doap:name "ModGUI Host" ;
    doap:license <https://opensource.org/licenses/ISC> ;

    lv2:requiredFeature urid:map, work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable, state:threadSafeRestore, opts:options ;
    lv2:extensionData state:interface, work:interface ;

    ui:ui <urn:modgui-host:ui> ;

    patch:readable <urn:modgui-host:hostedPluginURI> ;
    patch:writable <urn:modgui-host:hostedPluginURI> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "audio_in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "audio_in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "audio_out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "audio_out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:index 4 ;
        lv2:symbol "events_in" ;
        lv2:name "Events In" ;
        lv2:designation lv2:control ;
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:index 5 ;
        lv2:symbol "events_out" ;
        lv2:name "Events Out" ;
        lv2:designation lv2:control ;
    ] .

# ── UI ────────────────────────────────────────────────────────────────────────
<urn:modgui-host:ui>
    a ui:Gtk3UI ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature ui:resize, ui:noUserResize ;
    ui:portNotification [
        ui:plugin <urn:modgui-host:plugin> ;
        lv2:symbol "events_out" ;
        ui:protocol atom:eventTransfer ;
    ] .
